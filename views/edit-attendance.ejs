<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Attendance - <%= record.schoolName %></title>
    <link rel="shortcut icon" href="/icon.png?v=4" type="image/png">
    <link rel="icon" type="image/png" sizes="32x32" href="/icon.png?v=4">
    <link rel="icon" type="image/png" sizes="192x192" href="/icon.png?v=4">
    <link rel="apple-touch-icon" href="/icon.png?v=4">
    <link rel="manifest" href="/manifest.json">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .map-wrapper-box {
            margin-top: 15px;
            background: #ffffff;
            padding: 14px;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 2px 6px rgba(0,0,0,0.02);
        }

        .map-section-title {
            font-size: 13px;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .gps-badge-info {
            background: #f1f5f9;
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 11px;
            color: #334155;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .btn-open-gmaps {
            background: #2563eb;
            color: #ffffff;
            text-decoration: none;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 10.5px;
            font-weight: 600;
        }
    </style>
</head>
<body style="background-color: #f3f4f6; padding: 12px;">
    <div class="app-container" style="max-width: 650px; margin: 0 auto; padding: 12px;">
        <header class="app-header">
            <div>
                <h3><%= record.schoolName %></h3>
                <span class="badge">AEO Verification Portal</span>
            </div>
            <a href="/admin?auth=true" class="btn-logout" style="background: #e0e7ff; color: #4f46e5;">← Back to Summary</a>
        </header>

        <form id="editForm">
            <input type="hidden" id="recordId" value="<%= record.id %>">
            <div class="table-responsive">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>Teacher Name & Designation</th>
                            <th>Attendance Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% record.attendance.forEach((item, index) => { %>
                            <tr>
                                <td class="teacher-name"><%= item.teacher %></td>
                                <td>
                                    <div class="status-options">
                                        <label class="radio-pill present">
                                            <input type="radio" name="status_<%= index %>" value="Present" <%= item.status === 'Present' ? 'checked' : '' %> onchange="toggleLeaveType(<%= index %>)">
                                            <span>Present</span>
                                        </label>
                                        <label class="radio-pill leave">
                                            <input type="radio" name="status_<%= index %>" value="Leave" <%= item.status === 'Leave' ? 'checked' : '' %> onchange="toggleLeaveType(<%= index %>)">
                                            <span>On Leave</span>
                                        </label>
                                        <label class="radio-pill absent">
                                            <input type="radio" name="status_<%= index %>" value="Absent" <%= item.status === 'Absent' ? 'checked' : '' %> onchange="toggleLeaveType(<%= index %>)">
                                            <span>Absent</span>
                                        </label>
                                    </div>
                                    <div id="leave_div_<%= index %>" style="<%= item.status === 'Leave' ? 'display:block;' : 'display:none;' %>" class="leave-dropdown-box">
                                        <select name="leaveType_<%= index %>" class="form-control-sm">
                                            <option value="Casual Leave" <%= item.leaveType === 'Casual Leave' ? 'selected' : '' %>>Casual Leave</option>
                                            <option value="Medical Leave" <%= item.leaveType === 'Medical Leave' ? 'selected' : '' %>>Medical Leave</option>
                                            <option value="Maternity Leave" <%= item.leaveType === 'Maternity Leave' ? 'selected' : '' %>>Maternity Leave</option>
                                            <option value="Other Leave" <%= item.leaveType === 'Other Leave' ? 'selected' : '' %>>Other Leave</option>
                                        </select>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <!-- Uploaded Register Photo & GPS Map Section -->
            <div class="map-wrapper-box">
                <div class="map-section-title">📸 Attendance Register & Location</div>
                
                <% if(record.photo) { %>
                    <div style="margin-bottom: 12px; text-align: center;">
                        <img src="<%= record.photo %>" alt="Register Photo" style="width: 100%; max-width: 320px; border-radius: 8px; border: 1px solid #cbd5e1;">
                    </div>
                <% } else { %>
                    <p style="font-size: 11px; color: #64748b; margin-bottom: 10px;">No register photo uploaded.</p>
                <% } %>

                <% 
                    let lat = (record.location && record.location.lat) ? record.location.lat : '25.736000';
                    let lng = (record.location && record.location.lng) ? record.location.lng : '88.608000';
                %>

                <div class="gps-badge-info">
                    <span>📍 <strong>GPS:</strong> <%= lat %>, <%= lng %></span>
                    <a href="https://www.google.com/maps/search/?api=1&query=<%= lat %>,<%= lng %>" target="_blank" class="btn-open-gmaps">Open Maps ↗</a>
                </div>

                <iframe
                    width="100%"
                    height="200"
                    frameborder="0"
                    style="border: 1px solid #cbd5e1; border-radius: 8px;"
                    src="https://maps.google.com/maps?q=<%= lat %>,<%= lng %>&z=16&output=embed">
                </iframe>
            </div>

            <button type="button" onclick="updateAttendance()" class="btn-submit-main" style="margin-top: 15px;">Save Changes</button>
        </form>
    </div>

    <!-- Animated Custom Modal Popup -->
    <div id="customModal" class="custom-modal-overlay">
        <div class="custom-modal-box">
            <div id="modalIcon" class="modal-icon-wrapper modal-icon-success">✓</div>
            <h3 id="modalTitle">Updated</h3>
            <p id="modalMessage">Attendance record updated successfully!</p>
            <button type="button" id="modalBtn" class="modal-btn-confirm" onclick="closeCustomModal()">OK</button>
        </div>
    </div>

    <script>
        const totalTeachersCount = <%= record.attendance.length %>;
        let redirectTarget = null;

        function showCustomModal(type, title, message, redirectUrl = null) {
            const modal = document.getElementById('customModal');
            const icon = document.getElementById('modalIcon');
            const titleEl = document.getElementById('modalTitle');
            const messageEl = document.getElementById('modalMessage');

            titleEl.textContent = title;
            messageEl.textContent = message;
            redirectTarget = redirectUrl;

            if (type === 'success') {
                icon.className = "modal-icon-wrapper modal-icon-success";
                icon.innerHTML = "✓";
            } else {
                icon.className = "modal-icon-wrapper modal-icon-error";
                icon.innerHTML = "✕";
            }

            modal.classList.add('active');
        }

        function closeCustomModal() {
            const modal = document.getElementById('customModal');
            modal.classList.remove('active');
            if (redirectTarget) {
                window.location.href = redirectTarget;
            }
        }

        function toggleLeaveType(index) {
            let radios = document.getElementsByName('status_' + index);
            let leaveDiv = document.getElementById('leave_div_' + index);
            let selectedValue = '';
            for(let r of radios) {
                if(r.checked) selectedValue = r.value;
            }
            leaveDiv.style.display = (selectedValue === 'Leave') ? 'block' : 'none';
        }

        function updateAttendance() {
            const recordId = document.getElementById('recordId').value;
            let attendanceArr = [];

            for(let i = 0; i < totalTeachersCount; i++) {
                let teacherName = document.querySelectorAll('.teacher-name')[i].textContent;
                let status = 'Present';
                let radios = document.getElementsByName('status_' + i);
                for(let r of radios) { if(r.checked) status = r.value; }
                
                let leaveType = '';
                if(status === 'Leave') {
                    leaveType = document.querySelector(`[name="leaveType_${i}"]`).value;
                }
                attendanceArr.push({ teacher: teacherName, status, leaveType });
            }

            fetch('/admin/school/update/' + recordId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ attendance: JSON.stringify(attendanceArr) })
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    showCustomModal('success', 'Changes Saved', 'Attendance record updated successfully!', data.redirectUrl);
                } else {
                    showCustomModal('error', 'Update Failed', data.message || 'Could not update.');
                }
            }).catch(err => {
                showCustomModal('error', 'Network Error', 'Connection problem occurred.');
            });
        }
    </script>
</body>
</html>