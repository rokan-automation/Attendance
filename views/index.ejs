<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Attendance - <%= school.id %>. <%= school.name %></title>
    <link rel="shortcut icon" href="/icon-192.png" type="image/png">
    <link rel="stylesheet" href="/css/style.css?v=20">
    
    <style>
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

        body {
            background-color: #f1f5f9;
            margin: 0;
            padding: 10px;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            touch-action: manipulation;
        }

        .app-container-school {
            max-width: 480px;
            margin: 0 auto;
            padding: 12px;
            background: #ffffff;
            border-radius: 14px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            border: 1.5px solid #e2e8f0;
            box-sizing: border-box;
        }

        /* Top Header */
        .school-header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1.5px solid #f1f5f9;
            padding-bottom: 8px;
            margin-bottom: 10px;
        }

        .school-header-bar h3 {
            font-size: 14px;
            font-weight: 800;
            color: #0f172a;
            margin: 0;
            line-height: 1.3;
        }

        .btn-back-school {
            background: #fee2e2;
            color: #dc2626;
            padding: 5px 14px;
            font-size: 12px;
            font-weight: 800;
            text-decoration: none;
            border-radius: 6px;
            border: 1px solid #fca5a5;
            white-space: nowrap;
            transition: transform 0.1s;
        }
        .btn-back-school:active { transform: scale(0.95); }

        /* Already Submitted Card - 100% Pure English */
        .already-submitted-card {
            background: #f0fdf4;
            border: 2px solid #86efac;
            border-radius: 12px;
            padding: 24px 16px;
            text-align: center;
            margin: 10px 0;
        }

        /* Lock Notice Box */
        .lock-notice-box {
            background: #fff1f2;
            border: 2px dashed #f43f5e;
            border-radius: 12px;
            padding: 24px 16px;
            text-align: center;
            margin: 10px 0;
        }

        .teacher-attendance-card-slim {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 8px 10px;
            margin-bottom: 6px;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .teacher-title-text {
            font-size: 12.5px;
            font-weight: 800;
            color: #1e293b;
        }

        .status-options-inline-flex {
            display: flex;
            gap: 6px;
            align-items: center;
            flex-wrap: wrap;
        }

        .radio-pill-compact {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 11.5px;
            font-weight: 700;
            padding: 4px 9px;
            border-radius: 6px;
            border: 1px solid #cbd5e1;
            cursor: pointer;
            background: #ffffff;
            user-select: none;
        }

        .leave-inline-container {
            margin-top: 6px;
            background: #fffbeb;
            border: 1.5px solid #fde68a;
            border-radius: 8px;
            padding: 8px 10px;
            animation: fadeInDrop 0.15s ease-out;
        }

        @keyframes fadeInDrop {
            from { opacity: 0; transform: translateY(-3px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .leave-inline-title {
            font-size: 11px;
            font-weight: 800;
            color: #b45309;
            display: block;
            margin-bottom: 6px;
        }

        .leave-chips-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
        }

        .leave-chip {
            background: #ffffff;
            border: 1px solid #cbd5e1;
            color: #475569;
            font-size: 11px;
            font-weight: 700;
            padding: 4px 8px;
            border-radius: 6px;
            cursor: pointer;
            user-select: none;
            transition: all 0.1s ease;
        }

        .leave-chip:active { transform: scale(0.96); }

        .leave-chip.active {
            background: #d97706;
            color: #ffffff;
            border-color: #d97706;
            box-shadow: 0 1px 3px rgba(217, 119, 6, 0.25);
        }

        .camera-capture-box {
            background: #f8fafc;
            border: 2px dashed #cbd5e1;
            padding: 10px;
            text-align: center;
            border-radius: 8px;
            margin-top: 10px;
            cursor: pointer;
        }

        .btn-submit-daily {
            background: #10b981;
            color: #ffffff;
            border: none;
            padding: 11px;
            font-size: 13.5px;
            font-weight: 800;
            border-radius: 10px;
            cursor: pointer;
            width: 100%;
            margin-top: 10px;
            box-shadow: 0 4px 10px rgba(16, 185, 129, 0.25);
            transition: transform 0.1s;
        }
        .btn-submit-daily:active { transform: scale(0.98); }

        .single-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(3px);
            display: none !important;
            align-items: center;
            justify-content: center;
            padding: 14px;
            z-index: 99999;
        }

        .single-modal-overlay.active {
            display: flex !important;
        }

        .single-modal-box {
            background: #ffffff;
            border-radius: 14px;
            padding: 20px 16px;
            width: 100%;
            max-width: 330px;
            text-align: center;
            box-shadow: 0 10px 25px rgba(0,0,0,0.18);
        }
    </style>
</head>
<body>
    <div class="app-container-school">
        
        <!-- Header -->
        <header class="school-header-bar">
            <div>
                <h3><%= school.id %>. <%= school.name %></h3>
                <span style="font-size: 11px; font-weight: 700; color: #4f46e5;">Teacher Attendance Portal</span>
            </div>
            <div>
                <a href="/logout" class="btn-back-school">Logout</a>
            </div>
        </header>

        <% if (alreadySubmitted) { %>
            <!-- Clean English Confirmation Card -->
            <div class="already-submitted-card">
                <span style="font-size: 40px; display: block; margin-bottom: 6px;">✅</span>
                <h4 style="font-size: 16px; font-weight: 800; color: #166534; margin: 0 0 6px 0;">Attendance Already Submitted!</h4>
                <p style="font-size: 12.5px; color: #374151; line-height: 1.4; margin: 0 0 14px 0;">
                    Daily attendance for <strong><%= school.name %></strong> on <strong><%= submissionDate %></strong> was successfully submitted at <strong><%= submissionTime %></strong>.<br><br>
                    <span style="color: #64748b; font-size: 11.5px;">(Submission is allowed only once per day. The portal will automatically reset after midnight 12:00 AM for the next day's attendance.)</span>
                </p>
                <a href="/logout" style="display: inline-block; background: #16a34a; color: white; text-decoration: none; padding: 8px 22px; border-radius: 8px; font-size: 13px; font-weight: 800;">Logout</a>
            </div>

        <% } else if (!isAllowed) { %>
            <!-- Submission Closed Card -->
            <div class="lock-notice-box">
                <span style="font-size: 38px; display: block; margin-bottom: 6px;">🔒</span>
                <h4 style="font-size: 15px; font-weight: 800; color: #be123c; margin: 0 0 6px 0;">Submission Closed</h4>
                <p style="font-size: 12px; color: #475569; line-height: 1.4; margin: 0 0 12px 0;">
                    Daily attendance submission is open until <strong>10:00 AM</strong>.<br>
                    Submission is currently locked. Please contact your <strong>Assistant Education Officer (AEO)</strong> to unlock permission.
                </p>
                <a href="/logout" style="display: inline-block; background: #dc2626; color: white; text-decoration: none; padding: 8px 18px; border-radius: 8px; font-size: 12.5px; font-weight: 800;">Logout</a>
            </div>

        <% } else { %>
            <!-- Fresh Attendance Submission Form -->
            <form id="attendanceForm">
                <input type="hidden" name="schoolId" id="schoolId" value="<%= school.id %>">
                
                <div style="display: flex; flex-direction: column;">
                    <% school.teachers.forEach((teacher, index) => { %>
                        <div class="teacher-attendance-card-slim">
                            <div class="teacher-title-text"><%= teacher %></div>
                            
                            <div class="status-options-inline-flex">
                                <label class="radio-pill-compact">
                                    <input type="radio" name="status_<%= index %>" value="Present" checked onchange="toggleLeaveType(<%= index %>)">
                                    <span>Present</span>
                                </label>
                                <label class="radio-pill-compact">
                                    <input type="radio" name="status_<%= index %>" value="Leave" onchange="toggleLeaveType(<%= index %>)">
                                    <span>On Leave</span>
                                </label>
                                <label class="radio-pill-compact">
                                    <input type="radio" name="status_<%= index %>" value="Absent" onchange="toggleLeaveType(<%= index %>)">
                                    <span>Absent</span>
                                </label>
                            </div>

                            <div id="leave_div_<%= index %>" class="leave-inline-container" style="display:none;">
                                <span class="leave-inline-title">📝 Select Leave Type:</span>
                                <div class="leave-chips-grid">
                                    <button type="button" class="leave-chip active" onclick="setLeaveType(<%= index %>, 'Casual Leave', this)">Casual Leave</button>
                                    <button type="button" class="leave-chip" onclick="setLeaveType(<%= index %>, 'Medical Leave', this)">Medical Leave</button>
                                    <button type="button" class="leave-chip" onclick="setLeaveType(<%= index %>, 'Maternity Leave', this)">Maternity Leave</button>
                                    <button type="button" class="leave-chip" onclick="setLeaveType(<%= index %>, 'Earned Leave', this)">Earned Leave</button>
                                    <button type="button" class="leave-chip" onclick="setLeaveType(<%= index %>, 'Other Leave', this)">Other Leave</button>
                                </div>
                                <input type="hidden" id="leaveInput_<%= index %>" value="Casual Leave">
                            </div>
                        </div>
                    <% }) %>
                </div>

                <div class="camera-capture-box" onclick="document.getElementById('registerPhoto').click()">
                    <span style="font-size: 12px; font-weight: 800; color: #4f46e5; display: block;">
                        📷 Capture Attendance Register Photo
                    </span>
                    <input type="file" id="registerPhoto" accept="image/*" capture="environment" required style="display: none;" onchange="handleImageSelection(this)">
                    <span id="fileNameDisplay" style="font-size: 11px; color: #64748b; margin-top: 2px; display: block;">No photo captured</span>
                </div>

                <button type="button" onclick="submitData()" class="btn-submit-daily" id="submitBtnMain">Submit Daily Report</button>
            </form>
        <% } %>
    </div>

    <!-- Single Status Modal -->
    <div id="singleCustomModal" class="single-modal-overlay">
        <div class="single-modal-box">
            <div id="modalIcon" style="font-size: 32px; margin-bottom: 6px;">✓</div>
            <h3 id="modalTitle" style="font-size: 16px; margin: 0 0 4px 0; font-weight: 800;">Status</h3>
            <p id="modalMessage" style="font-size: 12.5px; color: #475569; margin: 0 0 14px 0; line-height: 1.4;">Message text</p>
            <button type="button" id="modalOkBtn" style="width: 100%; background: #4f46e5; color: white; border: none; padding: 10px; border-radius: 8px; font-weight: 700; font-size: 13px; cursor: pointer;" onclick="closeSingleModal()">OK</button>
        </div>
    </div>

    <script>
        const teachersList = <%- JSON.stringify(school.teachers) %>;
        let shouldReloadOnClose = false;
        let compressedBlob = null;

        function showSingleModal(type, title, message, shouldReload = false) {
            document.getElementById('modalIcon').textContent = type === 'success' ? "✅" : "⚠️";
            document.getElementById('modalTitle').textContent = title;
            document.getElementById('modalMessage').textContent = message;
            shouldReloadOnClose = shouldReload;
            document.getElementById('singleCustomModal').classList.add('active');
        }

        function closeSingleModal() {
            document.getElementById('singleCustomModal').classList.remove('active');
            if (shouldReloadOnClose) window.location.reload();
        }

        function toggleLeaveType(index) {
            let radios = document.getElementsByName('status_' + index);
            let leaveDiv = document.getElementById('leave_div_' + index);
            let selectedValue = '';
            for(let r of radios) { if(r.checked) selectedValue = r.value; }
            leaveDiv.style.display = (selectedValue === 'Leave') ? 'block' : 'none';
        }

        function setLeaveType(index, leaveType, chipElement) {
            const container = chipElement.closest('.leave-chips-grid');
            container.querySelectorAll('.leave-chip').forEach(chip => chip.classList.remove('active'));
            chipElement.classList.add('active');
            document.getElementById('leaveInput_' + index).value = leaveType;
        }

        function handleImageSelection(input) {
            const display = document.getElementById('fileNameDisplay');
            if (input.files && input.files[0]) {
                const file = input.files[0];
                display.textContent = "⚡ Optimizing photo...";
                display.style.color = "#4f46e5";

                const reader = new FileReader();
                reader.readAsDataURL(file);
                reader.onload = (e) => {
                    const img = new Image();
                    img.src = e.target.result;
                    img.onload = () => {
                        const canvas = document.createElement('canvas');
                        const maxWidth = 900;
                        const scaleSize = maxWidth / img.width;
                        canvas.width = (img.width > maxWidth) ? maxWidth : img.width;
                        canvas.height = (img.width > maxWidth) ? (img.height * scaleSize) : img.height;

                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

                        canvas.toBlob((blob) => {
                            compressedBlob = blob;
                            display.textContent = "✅ Photo ready (" + Math.round(blob.size / 1024) + " KB)";
                            display.style.color = "#16a34a";
                        }, 'image/jpeg', 0.65);
                    };
                };
            }
        }

        function submitData() {
            if (!compressedBlob && !document.getElementById('registerPhoto').files[0]) {
                showSingleModal('error', 'Photo Required', 'Please capture or upload the attendance register photo first!');
                return;
            }

            const submitBtn = document.getElementById('submitBtnMain');
            submitBtn.textContent = "📍 Acquiring GPS Location...";
            submitBtn.disabled = true;

            const sendPayload = (lat, lng) => {
                submitBtn.textContent = "⚡ Submitting Report...";
                
                let formData = new FormData();
                formData.append('schoolId', document.getElementById('schoolId').value);
                formData.append('lat', lat);
                formData.append('lng', lng);
                
                if (compressedBlob) {
                    formData.append('registerPhoto', compressedBlob, 'register.jpg');
                } else {
                    formData.append('registerPhoto', document.getElementById('registerPhoto').files[0]);
                }

                let attendanceArr = [];
                teachersList.forEach((teacher, index) => {
                    let status = 'Present';
                    let radios = document.getElementsByName('status_' + index);
                    for(let r of radios) { if(r.checked) status = r.value; }
                    
                    let leaveType = '';
                    if(status === 'Leave') {
                        const leaveInput = document.getElementById('leaveInput_' + index);
                        leaveType = leaveInput ? leaveInput.value : 'Casual Leave';
                    }
                    attendanceArr.push({ teacher, status, leaveType });
                });

                formData.append('attendance', JSON.stringify(attendanceArr));

                fetch('/submit-attendance', {
                    method: 'POST',
                    body: formData
                })
                .then(res => res.json())
                .then(data => {
                    if(data.success) {
                        showSingleModal('success', 'Submitted!', 'Daily attendance report submitted successfully!', true);
                    } else {
                        showSingleModal('error', 'Submission Failed', data.message);
                        submitBtn.textContent = "Submit Daily Report";
                        submitBtn.disabled = false;
                    }
                }).catch(err => {
                    showSingleModal('error', 'Network Error', 'Please check your internet connection and try again.');
                    submitBtn.textContent = "Submit Daily Report";
                    submitBtn.disabled = false;
                });
            };

            if ("geolocation" in navigator) {
                navigator.geolocation.getCurrentPosition(
                    (pos) => sendPayload(pos.coords.latitude.toFixed(6), pos.coords.longitude.toFixed(6)),
                    () => sendPayload(25.736000, 88.608000),
                    { enableHighAccuracy: true, timeout: 5000 }
                );
            } else {
                sendPayload(25.736000, 88.608000);
            }
        }
    </script>
</body>
</html>