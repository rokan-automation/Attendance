<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Attendance - <%= school.id %>. <%= school.name %></title>
    <link rel="shortcut icon" href="/icon.png?v=12" type="image/png">
    <link rel="icon" type="image/png" sizes="32x32" href="/icon.png?v=12">
    <link rel="icon" type="image/png" sizes="192x192" href="/icon.png?v=12">
    <link rel="apple-touch-icon" href="/icon.png?v=12">
    <link rel="manifest" href="/manifest.json">
    <link rel="stylesheet" href="/css/style.css?v=12">
    <style>
        body {
            background-color: #f3f4f6 !important;
            margin: 0;
            padding: 8px;
        }

        .app-container-school {
            max-width: 480px;
            margin: 0 auto;
            padding: 12px;
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.04);
            border: 1.5px solid #e2e8f0;
            box-sizing: border-box;
        }

        .school-header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1.5px solid #f1f5f9;
            padding-bottom: 8px;
            margin-bottom: 10px;
        }

        .school-header-bar h3 {
            font-size: 14.5px;
            font-weight: 800;
            color: #0f172a;
            margin: 0;
            line-height: 1.3;
        }

        .btn-back-school {
            background: #e0e7ff;
            color: #4f46e5;
            padding: 5px 14px;
            font-size: 12px;
            font-weight: 800;
            text-decoration: none;
            border-radius: 6px;
            border: 1px solid #c7d2fe;
            white-space: nowrap;
        }

        /* Slim & Tight Teacher Card */
        .teacher-attendance-card-slim {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 7px 10px;
            margin-bottom: 6px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .teacher-title-text {
            font-size: 12.5px;
            font-weight: 800;
            color: #1e293b;
            line-height: 1.2;
        }

        /* Natural Auto-Width Small Buttons (Not Stretching 100%) */
        .status-options-inline-flex {
            display: flex;
            gap: 6px;
            align-items: center;
            flex-wrap: wrap;
        }

        .radio-pill-compact {
            display: inline-flex;
            align-items: center;
            gap: 3px;
            font-size: 11px;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 6px;
            border: 1px solid #cbd5e1;
            cursor: pointer;
            background: #ffffff;
            white-space: nowrap;
            width: auto; /* Natural small width */
        }

        .radio-pill-compact input {
            margin: 0;
            cursor: pointer;
        }

        .form-control-leave {
            padding: 4px 6px;
            font-size: 11px;
            border-radius: 6px;
            border: 1px solid #cbd5e1;
            width: 100%;
            max-width: 160px;
            margin-top: 3px;
            outline: none;
            background: #ffffff;
            display: block;
        }

        .camera-capture-box {
            background: #f8fafc;
            border: 2px dashed #cbd5e1;
            padding: 10px;
            text-align: center;
            border-radius: 10px;
            margin-top: 10px;
            cursor: pointer;
        }

        .camera-label-btn {
            font-size: 12px;
            font-weight: 800;
            color: #4f46e5;
            cursor: pointer;
            display: block;
        }

        .file-status-text {
            display: block;
            font-size: 10px;
            color: #64748b;
            margin-top: 2px;
        }

        .btn-submit-daily {
            background: #10b981;
            color: #ffffff;
            border: none;
            padding: 11px;
            font-size: 13px;
            font-weight: 800;
            border-radius: 10px;
            cursor: pointer;
            width: 100%;
            margin-top: 10px;
            box-shadow: 0 4px 10px rgba(16, 185, 129, 0.25);
            transition: 0.15s;
        }

        .btn-submit-daily:hover {
            background: #059669;
        }

        .lock-notice-box {
            background: #fff1f2;
            border: 2px dashed #f43f5e;
            border-radius: 12px;
            padding: 24px 16px;
            text-align: center;
            margin-top: 20px;
        }
        .lock-icon { font-size: 40px; margin-bottom: 8px; display: block; }
        .lock-title { font-size: 16px; font-weight: 800; color: #be123c; margin-bottom: 6px; }
        .lock-desc { font-size: 12px; color: #475569; line-height: 1.4; }
    </style>
</head>
<body>
    <div class="app-container-school">
        
        <!-- Header -->
        <header class="school-header-bar">
            <div>
                <h3><%= school.id %>. <%= school.name %></h3>
                <span class="badge" style="margin-top: 2px;">Teacher Attendance Portal</span>
            </div>
            <div>
                <a href="/" class="btn-back-school">Back</a>
            </div>
        </header>

        <% if (!isAllowed) { %>
            <div class="lock-notice-box">
                <span class="lock-icon">🔒</span>
                <h4 class="lock-title">Attendance Submission Closed</h4>
                <p class="lock-desc">
                    Daily attendance submission is allowed until <strong>10:00 AM</strong>.<br>
                    Submission is currently locked. Please contact your <strong>Assistant Education Officer (AEO)</strong> to unlock permission.
                </p>
            </div>
        <% } else { %>
            <form id="attendanceForm">
                <input type="hidden" name="schoolId" id="schoolId" value="<%= school.id %>">
                
                <div style="display: flex; flex-direction: column;">
                    <% school.teachers.forEach((teacher, index) => { %>
                        <div class="teacher-attendance-card-slim">
                            <div class="teacher-title-text"><%= teacher %></div>
                            
                            <!-- Natural Compact Width Buttons -->
                            <div class="status-options-inline-flex">
                                <label class="radio-pill-compact">
                                    <input type="radio" name="status_<%= index %>" value="Present" checked onchange="toggleLeaveType(<%= index %>)">
                                    <span>Present</span>
                                </label>
                                <label class="radio-pill-compact">
                                    <input type="radio" name="status_<%= index %>" value="Leave" onchange="toggleLeaveType(<%= index %>)">
                                    <span>On Leave</span>
                                </label>
                                <label class="radio-pill-compact">
                                    <input type="radio" name="status_<%= index %>" value="Absent" onchange="toggleLeaveType(<%= index %>)">
                                    <span>Absent</span>
                                </label>
                            </div>

                            <div id="leave_div_<%= index %>" style="display:none;">
                                <select name="leaveType_<%= index %>" class="form-control-leave">
                                    <option value="Casual Leave">Casual Leave</option>
                                    <option value="Medical Leave">Medical Leave</option>
                                    <option value="Maternity Leave">Maternity Leave</option>
                                    <option value="Other Leave">Other Leave</option>
                                </select>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <div class="camera-capture-box">
                    <label for="registerPhoto" class="camera-label-btn">
                        📷 Capture Attendance Register
                    </label>
                    <input type="file" id="registerPhoto" accept="image/*" capture="environment" required style="display: none;" onchange="handleImageSelection(this)">
                    <span id="fileNameDisplay" class="file-status-text">No photo captured</span>
                </div>

                <button type="button" onclick="submitData()" class="btn-submit-daily" id="submitBtnMain">Submit Daily Report</button>
            </form>
        <% } %>
    </div>

    <!-- Custom Modal Popup -->
    <div id="customModal" class="custom-modal-overlay">
        <div class="custom-modal-box">
            <div id="modalIcon" class="modal-icon-wrapper modal-icon-success">✓</div>
            <h3 id="modalTitle">Success</h3>
            <p id="modalMessage">Attendance submitted successfully!</p>
            <button type="button" id="modalBtn" class="modal-btn-confirm" onclick="closeCustomModal()">OK</button>
        </div>
    </div>

    <script>
        const teachersList = <%- JSON.stringify(school.teachers) %>;
        let redirectOnClose = false;
        let compressedBlob = null;

        function showCustomModal(type, title, message, shouldReload = false) {
            const modal = document.getElementById('customModal');
            document.getElementById('modalIcon').className = type === 'success' ? "modal-icon-wrapper modal-icon-success" : "modal-icon-wrapper modal-icon-error";
            document.getElementById('modalIcon').innerHTML = type === 'success' ? "✓" : "✕";
            document.getElementById('modalTitle').textContent = title;
            document.getElementById('modalMessage').textContent = message;
            redirectOnClose = shouldReload;
            modal.classList.add('active');
        }

        function closeCustomModal() {
            document.getElementById('customModal').classList.remove('active');
            if (redirectOnClose) {
                window.location.href = '/';
            }
        }

        function toggleLeaveType(index) {
            let radios = document.getElementsByName('status_' + index);
            let leaveDiv = document.getElementById('leave_div_' + index);
            let selectedValue = '';
            for(let r of radios) {
                if(r.checked) selectedValue = r.value;
            }
            leaveDiv.style.display = (selectedValue === 'Leave') ? 'block' : 'none';
        }

        function handleImageSelection(input) {
            const display = document.getElementById('fileNameDisplay');
            if (input.files && input.files[0]) {
                const file = input.files[0];
                display.textContent = "⚡ Optimizing photo...";
                display.style.color = "#4f46e5";

                const reader = new FileReader();
                reader.readAsDataURL(file);
                reader.onload = (e) => {
                    const img = new Image();
                    img.src = e.target.result;
                    img.onload = () => {
                        const canvas = document.createElement('canvas');
                        const maxWidth = 1000;
                        const scaleSize = maxWidth / img.width;
                        canvas.width = (img.width > maxWidth) ? maxWidth : img.width;
                        canvas.height = (img.width > maxWidth) ? (img.height * scaleSize) : img.height;

                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

                        canvas.toBlob((blob) => {
                            compressedBlob = blob;
                            display.textContent = "✅ Photo ready (" + Math.round(blob.size / 1024) + " KB)";
                            display.style.color = "#16a34a";
                        }, 'image/jpeg', 0.7);
                    };
                };
            }
        }

        function submitData() {
            if (!compressedBlob && !document.getElementById('registerPhoto').files[0]) {
                showCustomModal('error', 'Photo Required', 'Please capture or upload the attendance register photo first!');
                return;
            }

            const submitBtn = document.getElementById('submitBtnMain');
            submitBtn.textContent = "📍 Acquiring GPS Location...";
            submitBtn.disabled = true;

            const sendPayload = (lat, lng) => {
                submitBtn.textContent = "⚡ Submitting Report...";
                
                let formData = new FormData();
                formData.append('schoolId', document.getElementById('schoolId').value);
                formData.append('lat', lat);
                formData.append('lng', lng);
                
                if (compressedBlob) {
                    formData.append('registerPhoto', compressedBlob, 'register.jpg');
                } else {
                    formData.append('registerPhoto', document.getElementById('registerPhoto').files[0]);
                }

                let attendanceArr = [];
                teachersList.forEach((teacher, index) => {
                    let status = 'Present';
                    let radios = document.getElementsByName('status_' + index);
                    for(let r of radios) { if(r.checked) status = r.value; }
                    
                    let leaveType = '';
                    if(status === 'Leave') {
                        leaveType = document.querySelector(`[name="leaveType_${index}"]`).value;
                    }
                    attendanceArr.push({ teacher, status, leaveType });
                });

                formData.append('attendance', JSON.stringify(attendanceArr));

                fetch('/submit-attendance', {
                    method: 'POST',
                    body: formData
                })
                .then(res => res.json())
                .then(data => {
                    if(data.success) {
                        showCustomModal('success', 'Submitted!', 'Daily attendance report submitted successfully!', true);
                    } else {
                        showCustomModal('error', 'Submission Failed', data.message);
                        submitBtn.textContent = "Submit Daily Report";
                        submitBtn.disabled = false;
                    }
                }).catch(err => {
                    showCustomModal('error', 'Network Error', 'Please check your internet connection.');
                    submitBtn.textContent = "Submit Daily Report";
                    submitBtn.disabled = false;
                });
            };

            if ("geolocation" in navigator) {
                navigator.geolocation.getCurrentPosition(
                    (position) => {
                        const latitude = position.coords.latitude.toFixed(6);
                        const longitude = position.coords.longitude.toFixed(6);
                        sendPayload(latitude, longitude);
                    },
                    (error) => {
                        sendPayload(25.736000, 88.608000);
                    },
                    { enableHighAccuracy: true, timeout: 6000 }
                );
            } else {
                sendPayload(25.736000, 88.608000);
            }
        }
    </script>
</body>
</html>