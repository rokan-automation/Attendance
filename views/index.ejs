<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Attendance - <%= school.id %>. <%= school.name %></title>
    <link rel="shortcut icon" href="/icon-192.png" type="image/png">
    <link rel="stylesheet" href="/css/style.css?v=15">
    <style>
        body {
            background-color: #f1f5f9;
            margin: 0;
            padding: 10px;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            touch-action: manipulation;
        }

        .app-container-school {
            max-width: 480px;
            margin: 0 auto;
            padding: 12px;
            background: #ffffff;
            border-radius: 14px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            border: 1.5px solid #e2e8f0;
            box-sizing: border-box;
        }

        .school-header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1.5px solid #f1f5f9;
            padding-bottom: 8px;
            margin-bottom: 10px;
        }

        .school-header-bar h3 {
            font-size: 14px;
            font-weight: 800;
            color: #0f172a;
            margin: 0;
            line-height: 1.3;
        }

        .btn-back-school {
            background: #eef2ff;
            color: #4f46e5;
            padding: 6px 14px;
            font-size: 12px;
            font-weight: 800;
            text-decoration: none;
            border-radius: 6px;
            border: 1px solid #c7d2fe;
            white-space: nowrap;
        }

        /* Success Already Submitted Card */
        .already-submitted-card {
            background: #f0fdf4;
            border: 2px solid #86efac;
            border-radius: 12px;
            padding: 24px 16px;
            text-align: center;
            margin: 10px 0;
        }

        /* Lock Notice Box */
        .lock-notice-box {
            background: #fff1f2;
            border: 2px dashed #f43f5e;
            border-radius: 12px;
            padding: 24px 16px;
            text-align: center;
            margin: 10px 0;
        }

        .teacher-attendance-card-slim {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 8px 10px;
            margin-bottom: 6px;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .teacher-title-text {
            font-size: 12.5px;
            font-weight: 800;
            color: #1e293b;
        }

        .status-options-inline-flex {
            display: flex;
            gap: 6px;
            align-items: center;
            flex-wrap: wrap;
        }

        .radio-pill-compact {
            display: inline-flex;
            align-items: center;
            gap: 3px;
            font-size: 11px;
            font-weight: 700;
            padding: 4px 8px;
            border-radius: 6px;
            border: 1px solid #cbd5e1;
            cursor: pointer;
            background: #ffffff;
            user-select: none;
        }

        .form-control-leave {
            padding: 4px 8px;
            font-size: 11px;
            border-radius: 6px;
            border: 1px solid #cbd5e1;
            width: 100%;
            max-width: 180px;
            margin-top: 3px;
            outline: none;
            background: #ffffff;
        }

        .camera-capture-box {
            background: #f8fafc;
            border: 2px dashed #cbd5e1;
            padding: 10px;
            text-align: center;
            border-radius: 8px;
            margin-top: 10px;
            cursor: pointer;
        }

        .btn-submit-daily {
            background: #10b981;
            color: #ffffff;
            border: none;
            padding: 11px;
            font-size: 13.5px;
            font-weight: 800;
            border-radius: 10px;
            cursor: pointer;
            width: 100%;
            margin-top: 10px;
            box-shadow: 0 4px 10px rgba(16, 185, 129, 0.25);
        }

        /* Modal */
        .custom-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(3px);
            display: none;
            align-items: center;
            justify-content: center;
            padding: 14px;
            z-index: 9999;
        }
        .custom-modal-overlay.active { display: flex; }
        .custom-modal-box {
            background: #ffffff;
            border-radius: 14px;
            padding: 18px 16px;
            width: 100%;
            max-width: 340px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="app-container-school">
        
        <!-- Header -->
        <header class="school-header-bar">
            <div>
                <h3><%= school.id %>. <%= school.name %></h3>
                <span style="font-size: 11px; font-weight: 700; color: #4f46e5;">Teacher Attendance Portal</span>
            </div>
            <div>
                <a href="/logout" class="btn-back-school">Logout</a>
            </div>
        </header>

        <% if (alreadySubmitted) { %>
            <!-- অলরেডি সাবমিট করা হয়ে গেলে এই সুন্দর মেসেজ কার্ড দেখাবে -->
            <div class="already-submitted-card">
                <span style="font-size: 40px; display: block; margin-bottom: 6px;">✅</span>
                <h4 style="font-size: 16px; font-weight: 800; color: #166534; margin: 0 0 6px 0;">আজকের হাজিরা জমা হয়েছে!</h4>
                <p style="font-size: 12.5px; color: #374151; line-height: 1.4; margin: 0 0 14px 0;">
                    আপনার বিদ্যালয়ের আজকের (<strong><%= submissionDate %></strong>) দৈনিক হাজিরা <strong><%= submissionTime %></strong> মিনিটে সফলভাবে জমা হয়েছে।<br><br>
                    <span style="color: #64748b; font-size: 11.5px;">(দিনে শুধুমাত্র একবারই ফরম সাবমিট করা যাবে। আগামীকাল রাত ১২:০০ টার পর ফরমটি আবার ওপেন হবে।)</span>
                </p>
                <a href="/logout" style="display: inline-block; background: #16a34a; color: white; text-decoration: none; padding: 8px 20px; border-radius: 8px; font-size: 13px; font-weight: 800;">ঠিক আছে</a>
            </div>

        <% } else if (!isAllowed) { %>
            <!-- সকাল ১০টার পর বন্ধ থাকলে এই কার্ড দেখাবে -->
            <div class="lock-notice-box">
                <span style="font-size: 38px; display: block; margin-bottom: 6px;">🔒</span>
                <h4 style="font-size: 15px; font-weight: 800; color: #be123c; margin: 0 0 6px 0;">হাজিরা সাবমিশন বন্ধ</h4>
                <p style="font-size: 12px; color: #475569; line-height: 1.4; margin: 0 0 12px 0;">
                    দৈনিক হাজিরা সাবমিশনের নির্ধারিত সময় সকাল <strong>১০:০০ টা</strong> পর্যন্ত।<br>
                    নির্ধারিত সময় পার হওয়ায় সাবমিশন লক করা হয়েছে। বিশেষ প্রয়োজনে <strong>সহকারী উপজেলা শিক্ষা অফিসারের (AEO)</strong> সাথে যোগাযোগ করুন।
                </p>
                <a href="/logout" style="display: inline-block; background: #dc2626; color: white; text-decoration: none; padding: 8px 18px; border-radius: 8px; font-size: 12.5px; font-weight: 800;">লগআউট</a>
            </div>

        <% } else { %>
            <!-- ফ্রেশ সাবমিশন ফর্ম -->
            <form id="attendanceForm">
                <input type="hidden" name="schoolId" id="schoolId" value="<%= school.id %>">
                
                <div style="display: flex; flex-direction: column;">
                    <% school.teachers.forEach((teacher, index) => { %>
                        <div class="teacher-attendance-card-slim">
                            <div class="teacher-title-text"><%= teacher %></div>
                            
                            <div class="status-options-inline-flex">
                                <label class="radio-pill-compact">
                                    <input type="radio" name="status_<%= index %>" value="Present" checked onchange="toggleLeaveType(<%= index %>)">
                                    <span>Present</span>
                                </label>
                                <label class="radio-pill-compact">
                                    <input type="radio" name="status_<%= index %>" value="Leave" onchange="toggleLeaveType(<%= index %>)">
                                    <span>On Leave</span>
                                </label>
                                <label class="radio-pill-compact">
                                    <input type="radio" name="status_<%= index %>" value="Absent" onchange="toggleLeaveType(<%= index %>)">
                                    <span>Absent</span>
                                </label>
                            </div>

                            <div id="leave_div_<%= index %>" style="display:none;">
                                <select name="leaveType_<%= index %>" class="form-control-leave">
                                    <option value="Casual Leave">Casual Leave (নৈমিত্তিক)</option>
                                    <option value="Medical Leave">Medical Leave (চিকিৎসা)</option>
                                    <option value="Maternity Leave">Maternity Leave (মাতৃত্বকালীন)</option>
                                    <option value="Earned Leave">Earned Leave (অর্জিত)</option>
                                    <option value="Other Leave">Other Leave (অন্যান্য)</option>
                                </select>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <div class="camera-capture-box" onclick="document.getElementById('registerPhoto').click()">
                    <span style="font-size: 12px; font-weight: 800; color: #4f46e5; display: block;">
                        📷 Capture Attendance Register Photo
                    </span>
                    <input type="file" id="registerPhoto" accept="image/*" capture="environment" required style="display: none;" onchange="handleImageSelection(this)">
                    <span id="fileNameDisplay" style="font-size: 11px; color: #64748b; margin-top: 2px; display: block;">No photo captured</span>
                </div>

                <button type="button" onclick="submitData()" class="btn-submit-daily" id="submitBtnMain">Submit Daily Report</button>
            </form>
        <% } %>
    </div>

    <!-- Custom Modal -->
    <div id="customModal" class="custom-modal-overlay">
        <div class="custom-modal-box">
            <div id="modalIcon" style="font-size: 32px; margin-bottom: 6px;">✓</div>
            <h3 id="modalTitle" style="font-size: 16px; margin: 0 0 4px 0;">Status</h3>
            <p id="modalMessage" style="font-size: 12.5px; color: #475569; margin: 0 0 12px 0;">Action message</p>
            <button type="button" id="modalBtn" style="width: 100%; background: #4f46e5; color: white; border: none; padding: 10px; border-radius: 8px; font-weight: 700; cursor: pointer;" onclick="closeCustomModal()">OK</button>
        </div>
    </div>

    <script>
        const teachersList = <%- JSON.stringify(school.teachers) %>;
        let redirectOnClose = false;
        let compressedBlob = null;

        function showCustomModal(type, title, message, shouldRedirect = false) {
            document.getElementById('modalIcon').textContent = type === 'success' ? "✅" : "⚠️";
            document.getElementById('modalTitle').textContent = title;
            document.getElementById('modalMessage').textContent = message;
            redirectOnClose = shouldRedirect;
            document.getElementById('customModal').classList.add('active');
        }

        function closeCustomModal() {
            document.getElementById('customModal').classList.remove('active');
            if (redirectOnClose) window.location.reload();
        }

        function toggleLeaveType(index) {
            let radios = document.getElementsByName('status_' + index);
            let leaveDiv = document.getElementById('leave_div_' + index);
            let selectedValue = '';
            for(let r of radios) { if(r.checked) selectedValue = r.value; }
            leaveDiv.style.display = (selectedValue === 'Leave') ? 'block' : 'none';
        }

        function handleImageSelection(input) {
            const display = document.getElementById('fileNameDisplay');
            if (input.files && input.files[0]) {
                const file = input.files[0];
                display.textContent = "⚡ Optimizing photo...";
                display.style.color = "#4f46e5";

                const reader = new FileReader();
                reader.readAsDataURL(file);
                reader.onload = (e) => {
                    const img = new Image();
                    img.src = e.target.result;
                    img.onload = () => {
                        const canvas = document.createElement('canvas');
                        const maxWidth = 900;
                        const scaleSize = maxWidth / img.width;
                        canvas.width = (img.width > maxWidth) ? maxWidth : img.width;
                        canvas.height = (img.width > maxWidth) ? (img.height * scaleSize) : img.height;

                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

                        canvas.toBlob((blob) => {
                            compressedBlob = blob;
                            display.textContent = "✅ Photo ready (" + Math.round(blob.size / 1024) + " KB)";
                            display.style.color = "#16a34a";
                        }, 'image/jpeg', 0.65);
                    };
                };
            }
        }

        function submitData() {
            if (!compressedBlob && !document.getElementById('registerPhoto').files[0]) {
                showCustomModal('error', 'Photo Required', 'অনুগ্রহ করে হাজিরা খাতার ছবি তুলুন!');
                return;
            }

            const submitBtn = document.getElementById('submitBtnMain');
            submitBtn.textContent = "📍 Acquiring GPS...";
            submitBtn.disabled = true;

            const sendPayload = (lat, lng) => {
                submitBtn.textContent = "⚡ Submitting Report...";
                
                let formData = new FormData();
                formData.append('schoolId', document.getElementById('schoolId').value);
                formData.append('lat', lat);
                formData.append('lng', lng);
                
                if (compressedBlob) {
                    formData.append('registerPhoto', compressedBlob, 'register.jpg');
                } else {
                    formData.append('registerPhoto', document.getElementById('registerPhoto').files[0]);
                }

                let attendanceArr = [];
                teachersList.forEach((teacher, index) => {
                    let status = 'Present';
                    let radios = document.getElementsByName('status_' + index);
                    for(let r of radios) { if(r.checked) status = r.value; }
                    
                    let leaveType = '';
                    if(status === 'Leave') {
                        leaveType = document.querySelector(`[name="leaveType_${index}"]`).value;
                    }
                    attendanceArr.push({ teacher, status, leaveType });
                });

                formData.append('attendance', JSON.stringify(attendanceArr));

                fetch('/submit-attendance', {
                    method: 'POST',
                    body: formData
                })
                .then(res => res.json())
                .then(data => {
                    if(data.success) {
                        showCustomModal('success', 'জমা হয়েছে!', 'দৈনিক হাজিরা সফলভাবে জমা নেওয়া হয়েছে!', true);
                    } else {
                        showCustomModal('error', 'ব্যর্থ হয়েছে', data.message);
                        submitBtn.textContent = "Submit Daily Report";
                        submitBtn.disabled = false;
                    }
                }).catch(err => {
                    showCustomModal('error', 'নেটওয়ার্ক সমস্যা', 'ইন্টারনেট কানেকশন চেক করুন।');
                    submitBtn.textContent = "Submit Daily Report";
                    submitBtn.disabled = false;
                });
            };

            if ("geolocation" in navigator) {
                navigator.geolocation.getCurrentPosition(
                    (pos) => sendPayload(pos.coords.latitude.toFixed(6), pos.coords.longitude.toFixed(6)),
                    () => sendPayload(25.736000, 88.608000),
                    { enableHighAccuracy: true, timeout: 5000 }
                );
            } else {
                sendPayload(25.736000, 88.608000);
            }
        }
    </script>
</body>
</html>