<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Attendance</title>
    <link rel="shortcut icon" href="/icon.png?v=3" type="image/png">
    <link rel="icon" type="image/png" sizes="32x32" href="/icon.png?v=3">
    <link rel="icon" type="image/png" sizes="192x192" href="/icon.png?v=3">
    <link rel="apple-touch-icon" href="/icon.png?v=3">
    <link rel="manifest" href="/manifest.json">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* Premium Splash Screen Animation */
        #splashScreen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 99999;
            transition: opacity 0.8s ease, visibility 0.8s ease;
        }

        .splash-content {
            text-align: center;
            color: #ffffff;
            animation: zoomFadeIn 1s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .splash-app-title {
            font-size: 28px;
            font-weight: 800;
            letter-spacing: 1px;
            margin-bottom: 6px;
            background: linear-gradient(to right, #a5b4fc, #ffffff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .splash-sub {
            font-size: 13px;
            color: #cbd5e1;
            margin-bottom: 25px;
        }

        .developer-badge {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 10px 22px;
            border-radius: 30px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            animation: pulseGlow 2s infinite alternate;
        }

        .dev-label {
            display: block;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #93c5fd;
            margin-bottom: 2px;
        }

        .dev-name {
            font-size: 16px;
            font-weight: 700;
            color: #ffffff;
        }

        @keyframes zoomFadeIn {
            0% { opacity: 0; transform: scale(0.85); }
            100% { opacity: 1; transform: scale(1); }
        }

        @keyframes pulseGlow {
            0% { box-shadow: 0 0 10px rgba(99, 102, 241, 0.3); }
            100% { box-shadow: 0 0 25px rgba(165, 180, 252, 0.6); }
        }
    </style>
</head>
<body>
    <!-- Animated Splash Screen -->
    <div id="splashScreen">
        <div class="splash-content">
            <h1 class="splash-app-title">Attendance</h1>
            <p class="splash-sub">Bochaganj Primary Education</p>
            <div class="developer-badge">
                <span class="dev-label">Developed by</span>
                <span class="dev-name">Md. Rokanuzzaman Rokan</span>
            </div>
        </div>
    </div>

    <div class="auth-wrapper">
        <div class="auth-card">
            <div class="brand-header">
                <h2>Attendance</h2>
                <p>Bochaganj Primary Education</p>
            </div>

            <% if(typeof error !== 'undefined' && error) { %>
                <div class="alert-error"><%= error %></div>
            <% } %>

            <div class="tab-buttons">
                <button type="button" class="tab-btn active" id="schoolTabBtn" onclick="switchTab('school')">School Login</button>
                <button type="button" class="tab-btn" id="adminTabBtn" onclick="switchTab('admin')">AEO Portal</button>
            </div>

            <form action="/login" method="POST" id="schoolForm" class="auth-form">
                <input type="hidden" name="role" value="school">
                <input type="hidden" name="schoolId" id="selectedSchoolId" value="1">

                <div class="input-group">
                    <label>Select Institution</label>
                    <div class="custom-select-trigger" onclick="openSchoolModal()">
                        <span class="trigger-text" id="selectedSchoolText">1. Bochaganj Model Govt. Primary School</span>
                        <span class="trigger-icon">▼</span>
                    </div>
                </div>
                <button type="submit" class="btn-submit">Access School Portal</button>
            </form>

            <form action="/login" method="POST" id="adminForm" class="auth-form" style="display: none;">
                <input type="hidden" name="role" value="admin">
                <div class="input-group">
                    <label>AEO Secure Password</label>
                    <input type="password" name="password" placeholder="Enter secure password" required>
                </div>
                <button type="submit" class="btn-submit">Access AEO Dashboard</button>
            </form>
        </div>
    </div>

    <!-- Custom Searchable School Selector Popup Modal -->
    <div id="schoolModal" class="school-modal-overlay">
        <div class="school-modal-card">
            <div class="school-modal-header">
                <h4>Select Primary School</h4>
                <button type="button" class="btn-close-modal" onclick="closeSchoolModal()">✕</button>
            </div>
            <div class="school-search-box">
                <input type="text" id="schoolSearchInput" placeholder="🔍 Search school name or serial..." onkeyup="filterSchools()">
            </div>
            <div class="school-list-container" id="schoolList">
                <button type="button" class="school-item-btn" onclick="selectSchool(1, '1. Bochaganj Model Govt. Primary School')">
                    <span class="school-serial-tag">1</span>
                    <span class="school-item-title">Bochaganj Model Govt. Primary School</span>
                </button>
                <button type="button" class="school-item-btn" onclick="selectSchool(2, '2. Setabganj Upashahar Govt. Primary School')">
                    <span class="school-serial-tag">2</span>
                    <span class="school-item-title">Setabganj Upashahar Govt. Primary School</span>
                </button>
                <button type="button" class="school-item-btn" onclick="selectSchool(3, '3. Bochaganj Central Govt. Primary School')">
                    <span class="school-serial-tag">3</span>
                    <span class="school-item-title">Bochaganj Central Govt. Primary School</span>
                </button>
                <button type="button" class="school-item-btn" onclick="selectSchool(4, '4. Muraripur Govt. Primary School')">
                    <span class="school-serial-tag">4</span>
                    <span class="school-item-title">Muraripur Govt. Primary School</span>
                </button>
                <button type="button" class="school-item-btn" onclick="selectSchool(5, '5. Chawk Rampur Govt. Primary School')">
                    <span class="school-serial-tag">5</span>
                    <span class="school-item-title">Chawk Rampur Govt. Primary School</span>
                </button>
                <button type="button" class="school-item-btn" onclick="selectSchool(6, '6. Bogula Govt. Primary School')">
                    <span class="school-serial-tag">6</span>
                    <span class="school-item-title">Bogula Govt. Primary School</span>
                </button>
                <button type="button" class="school-item-btn" onclick="selectSchool(7, '7. Chira Govt. Primary School')">
                    <span class="school-serial-tag">7</span>
                    <span class="school-item-title">Chira Govt. Primary School</span>
                </button>
                <button type="button" class="school-item-btn" onclick="selectSchool(8, '8. Gopalpur Govt. Primary School')">
                    <span class="school-serial-tag">8</span>
                    <span class="school-item-title">Gopalpur Govt. Primary School</span>
                </button>
                <button type="button" class="school-item-btn" onclick="selectSchool(9, '9. Ishania Govt. Primary School')">
                    <span class="school-serial-tag">9</span>
                    <span class="school-item-title">Ishania Govt. Primary School</span>
                </button>
                <button type="button" class="school-item-btn" onclick="selectSchool(10, '10. Nandigram Govt. Primary School')">
                    <span class="school-serial-tag">10</span>
                    <span class="school-item-title">Nandigram Govt. Primary School</span>
                </button>
                <button type="button" class="school-item-btn" onclick="selectSchool(11, '11. Shibpur Govt. Primary School')">
                    <span class="school-serial-tag">11</span>
                    <span class="school-item-title">Shibpur Govt. Primary School</span>
                </button>
                <button type="button" class="school-item-btn" onclick="selectSchool(12, '12. Ratanpur Govt. Primary School')">
                    <span class="school-serial-tag">12</span>
                    <span class="school-item-title">Ratanpur Govt. Primary School</span>
                </button>
                <button type="button" class="school-item-btn" onclick="selectSchool(13, '13. Chak Kalikapur Govt. Primary School')">
                    <span class="school-serial-tag">13</span>
                    <span class="school-item-title">Chak Kalikapur Govt. Primary School</span>
                </button>
                <button type="button" class="school-item-btn" onclick="selectSchool(14, '14. Bara Maheshtpur Govt. Primary School')">
                    <span class="school-serial-tag">14</span>
                    <span class="school-item-title">Bara Maheshtpur Govt. Primary School</span>
                </button>
                <button type="button" class="school-item-btn" onclick="selectSchool(15, '15. Chatra Govt. Primary School')">
                    <span class="school-serial-tag">15</span>
                    <span class="school-item-title">Chatra Govt. Primary School</span>
                </button>
                <button type="button" class="school-item-btn" onclick="selectSchool(16, '16. Jagannathpur Govt. Primary School')">
                    <span class="school-serial-tag">16</span>
                    <span class="school-item-title">Jagannathpur Govt. Primary School</span>
                </button>
                <button type="button" class="school-item-btn" onclick="selectSchool(17, '17. Kashipur Govt. Primary School')">
                    <span class="school-serial-tag">17</span>
                    <span class="school-item-title">Kashipur Govt. Primary School</span>
                </button>
                <button type="button" class="school-item-btn" onclick="selectSchool(18, '18. Ramnagar Govt. Primary School')">
                    <span class="school-serial-tag">18</span>
                    <span class="school-item-title">Ramnagar Govt. Primary School</span>
                </button>
                <button type="button" class="school-item-btn" onclick="selectSchool(19, '19. Kismat Bogula Govt. Primary School')">
                    <span class="school-serial-tag">19</span>
                    <span class="school-item-title">Kismat Bogula Govt. Primary School</span>
                </button>
                <button type="button" class="school-item-btn" onclick="selectSchool(20, '20. Bahadurpur Govt. Primary School')">
                    <span class="school-serial-tag">20</span>
                    <span class="school-item-title">Bahadurpur Govt. Primary School</span>
                </button>
                <button type="button" class="school-item-btn" onclick="selectSchool(21, '21. Bhatgaon Govt. Primary School')">
                    <span class="school-serial-tag">21</span>
                    <span class="school-item-title">Bhatgaon Govt. Primary School</span>
                </button>
                <button type="button" class="school-item-btn" onclick="selectSchool(22, '22. Salandar Govt. Primary School')">
                    <span class="school-serial-tag">22</span>
                    <span class="school-item-title">Salandar Govt. Primary School</span>
                </button>
                <button type="button" class="school-item-btn" onclick="selectSchool(23, '23. Nayaghat Govt. Primary School')">
                    <span class="school-serial-tag">23</span>
                    <span class="school-item-title">Nayaghat Govt. Primary School</span>
                </button>
                <button type="button" class="school-item-btn" onclick="selectSchool(24, '24. Sahapur Govt. Primary School')">
                    <span class="school-serial-tag">24</span>
                    <span class="school-item-title">Sahapur Govt. Primary School</span>
                </button>
                <button type="button" class="school-item-btn" onclick="selectSchool(25, '25. Chakpara Govt. Primary School')">
                    <span class="school-serial-tag">25</span>
                    <span class="school-item-title">Chakpara Govt. Primary School</span>
                </button>
            </div>
        </div>
    </div>

    <script>
        // Hide Splash Screen smoothly after 2 seconds
        window.addEventListener('load', () => {
            setTimeout(() => {
                const splash = document.getElementById('splashScreen');
                splash.style.opacity = '0';
                setTimeout(() => {
                    splash.style.display = 'none';
                }, 800);
            }, 1800);
        });

        function switchTab(type) {
            const schoolBtn = document.getElementById('schoolTabBtn');
            const adminBtn = document.getElementById('adminTabBtn');
            const schoolForm = document.getElementById('schoolForm');
            const adminForm = document.getElementById('adminForm');

            if(type === 'school') {
                schoolBtn.classList.add('active');
                adminBtn.classList.remove('active');
                schoolForm.style.display = 'block';
                adminForm.style.display = 'none';
            } else {
                adminBtn.classList.add('active');
                schoolBtn.classList.remove('active');
                adminForm.style.display = 'block';
                schoolForm.style.display = 'none';
            }
        }

        function openSchoolModal() {
            document.getElementById('schoolModal').classList.add('active');
            document.getElementById('schoolSearchInput').focus();
        }

        function closeSchoolModal() {
            document.getElementById('schoolModal').classList.remove('active');
        }

        function selectSchool(id, text) {
            document.getElementById('selectedSchoolId').value = id;
            document.getElementById('selectedSchoolText').textContent = text;
            closeSchoolModal();
        }

        function filterSchools() {
            const query = document.getElementById('schoolSearchInput').value.toLowerCase();
            const items = document.querySelectorAll('.school-item-btn');
            items.forEach(item => {
                const text = item.textContent.toLowerCase();
                item.style.display = text.includes(query) ? 'flex' : 'none';
            });
        }
    </script>
</body>
</html>